# ==============================================================================
# SelfID — Sovereign Identity Wallet Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Frontend & Supabase Configuration
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
# Note: If Supabase credentials are empty, SelfID automatically runs in
# secure in-memory mode with full cryptographic signing and verification.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# ------------------------------------------------------------------------------
# 3. Server Cryptographic Secrets
# ------------------------------------------------------------------------------
# AES-256-GCM Credential Encryption Key (32-byte hex or string)
# Stored strictly on the server; never exposed to browser or verifiers.
CREDENTIAL_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 4. Gemini API Configuration (Server-side)
# ------------------------------------------------------------------------------
# Powers sample document OCR/extraction and the Request Privacy Helper
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 5. SelfID Smart Contract & Relayer Configuration (Ethers v6)
# ------------------------------------------------------------------------------
# CHAIN_MODE="mock" uses local EIP-712/EIP-191 signature-verified simulation.
# Set CHAIN_MODE="live" to broadcast transactions directly to Polygon Amoy Testnet.
# When CHAIN_MODE="live", the app always reads the real relayer wallet balance from the chain.
CHAIN_MODE="mock"
CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"
CHAIN_ID="80002"
RPC_URL="https://rpc-amoy.polygon.technology"
RELAYER_PRIVATE_KEY="0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Optional test balance override: strictly ignored unless DEMO_MODE="test-balance"
# TEST_RELAYER_BALANCE="1.5"

# ------------------------------------------------------------------------------
# 6. Live Demo Settings
# ------------------------------------------------------------------------------
# DEMO_MODE="true" enables the "Reset demo data" button and health badge controls
DEMO_MODE="true"
VITE_DEMO_MODE="true"
